class Solution {
public:
    int threeSumClosest(vector<int>& a, int target) {
        sort(a.begin(), a.end());
        int n = a.size(), ans = a[0] + a[1] + a[2];

        for (int i = 0; i < n - 2; i++) {
            for (int j = i + 1; j < n - 1; j++) {
                int x = target - (a[i] + a[j]);

                auto it = lower_bound(a.begin() + j + 1, a.end(), x);

                if (it != a.end()) {
                    int sum = a[i] + a[j] + *it;
                    if (abs(target - sum) < abs(target - ans))
                        ans = sum;
                }
                if (it != a.begin() + j + 1) {
                    --it;
                    int sum = a[i] + a[j] + *it;
                    if (abs(target - sum) < abs(target - ans))
                        ans = sum;
                }
            }
        }
        return ans;
    }
};
