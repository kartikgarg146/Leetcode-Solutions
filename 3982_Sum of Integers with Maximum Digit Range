class Solution {
public:
    int maxDigitRange(vector<int>& nums) {
        int mxRange = -1, ans = 0;

        for (int x : nums) {
            int t = x;
            int mn = 9, mx = 0;

            while (t > 0) {
                int d = t % 10;
                mn = min(mn, d);
                mx = max(mx, d);
                t /= 10;
            }

            mxRange = max(mxRange, mx - mn);
        }

        for (int x : nums) {
            int t = x;
            int mn = 9, mx = 0;

            while (t > 0) {
                int d = t % 10;
                mn = min(mn, d);
                mx = max(mx, d);
                t /= 10;
            }

            if (mx - mn == mxRange)
                ans += x;
        }

        return ans;
    }
};
